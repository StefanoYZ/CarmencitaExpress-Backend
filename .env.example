# Backend FastAPI - local development defaults
# Copy to .env and never commit real credentials.
APP_NAME=Carmencita Smart System
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local PostgreSQL. Cloud Run uses the DB_* socket settings shown below instead.
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/carmencita_db
AUTO_CREATE_SCHEMA=true
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10

# Cloud Run / Cloud SQL (configured by GitHub Actions, not normally in local .env)
# DB_USER=carmencita
# DB_PASSWORD=provided-by-secret-manager
# DB_NAME=carmencita_db
# INSTANCE_UNIX_SOCKET=/cloudsql/project:southamerica-west1:carmencita-postgres
# AUTO_CREATE_SCHEMA=false

# SUNAT remains mock in Google Cloud.
SUNAT_ENV=mock
SUNAT_PROVIDER=lycet
SUNAT_ALLOW_REAL_EMISSION=false
LYCET_API_URL=http://localhost:8001
LYCET_CLIENT_TOKEN=your_lycet_token

MERCADOPAGO_PUBLIC_KEY=your_mercadopago_public_key
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token
RENIEC_API_URL=https://api-reniec.example.com
RENIEC_API_TOKEN=your_reniec_token

SECRET_KEY=change_me_for_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_me_for_production

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ASSISTANT_LLM_ENABLED=false
SEARCH_API_KEY=
SEARCH_API_URL=https://google.serper.dev/search
SEARCH_PROVIDER=serper
