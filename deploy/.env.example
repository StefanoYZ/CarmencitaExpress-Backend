# Cloud Run runtime values. GitHub Actions supplies these from repository
# variables and Secret Manager; this file is documentation only.
APP_NAME=Carmencita Smart System
API_PREFIX=/api/v1
CORS_ORIGINS=https://your-frontend.example

DB_USER=carmencita
DB_PASSWORD=stored-in-secret-manager
DB_NAME=carmencita_db
INSTANCE_UNIX_SOCKET=/cloudsql/your-project:southamerica-west1:carmencita-postgres
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=0
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10
AUTO_CREATE_SCHEMA=false

SUNAT_ENV=mock
SUNAT_ALLOW_REAL_EMISSION=false
ASSISTANT_LLM_ENABLED=false

SECRET_KEY=stored-in-secret-manager
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=stored-in-secret-manager
